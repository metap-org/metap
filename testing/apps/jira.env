# App-target config for testing/performance/, testing/security/zap/, and testing/disruptive/'s
# CI workflows — reference implementation for the "dựng base, wire từng app từ từ" plan. Adding a
# 2nd app (e.g. waf) later means adding one more file like this one, not touching any workflow.
#
# metap-demo-jira picked as the reference app since the 3 CI workflows that source this file
# needed *a* real working target to prove the base actually works, and jira is the simplest to
# boot in CI (1 binary, no frontend build step) — see `../../../.claude/plans/tidy-kindling-frog.md`
# for the full reasoning (metap-demo-crm, everything's old default, is deprecated since
# 2026-09-11; metap-demo-waf is a 3-service + gateway split, more CI setup than a first reference
# needs).
#
# Sourced with `set -a; source testing/apps/jira.env; set +a` (or `export $(cat ... | xargs)`) by
# each workflow — a plain bash-sourceable file, not YAML, so it works identically whether a
# workflow step sources it or a human runs `source testing/apps/jira.env` locally to reproduce a
# CI run by hand.

APP_NAME=jira
APP_REPO=../metap-demo-jira
APP_PORT=3100
BASE_URL="http://host.docker.internal:${APP_PORT}"
# Same name `docker/prometheus/prometheus.yml`'s scrape_configs would need a job for — the
# performance workflow adds this job on the fly (see testing/performance/report.sh's doc
# comment), not baked into the checked-in prometheus.yml, since that file is also used for local
# dev benchmarking against whichever app a human is running by hand.
METRICS_JOB_NAME=jira-server
# testing/security/zap/run.sh's existing APP= switch already knows about "jira" — this just
# names which value to pass so a workflow doesn't have to hardcode it a second time.
ZAP_APP_ARG=jira

# jira-server's tenant is a real provisioned DedicatedDb tenant (see ../../metap-demo-jira/
# .env.example), not a fixed dev id like crm-server's — a fresh one is provisioned per CI run
# (see .github/workflows/performance.yml/pentest.yml's own provisioning step) rather than reusing
# a long-lived tenant, so CI runs never collide or accumulate leftover data across runs.
DSN_SECRET_REF_NAME=CI_JIRA_DSN
DB_NAME_PREFIX=metap_ci_jira

# k6 defaults (testing/performance/k6/run.sh's ENTITY/SEED_TEMPLATE) — jira.projects is the
# simplest jira entity with no required relation field, matching crm.customers' role as the
# original default scenario's target.
DEFAULT_ENTITY=jira.projects
DEFAULT_SEED_TEMPLATE='{"key":"LOAD-{i}","name":"Load Test Project {i}"}'
