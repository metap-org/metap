NODE_ENV=development
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgres://metap:metap@localhost:5433/metap
# Optional: point the outbox at a different Postgres database than the main
# one above (e.g. once this module has its own dedicated database). Must
# still point at whatever database this module's own business writes land
# in — leave unset to reuse DATABASE_URL, today's default.
# OUTBOX_DATABASE_URL=postgres://metap:metap@localhost:5432/metap
RABBITMQ_URL=amqp://metap:metap@localhost:5672
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_JWT_PUBLIC_KEY_PATH=./keys/dev-jwt-public.pem
