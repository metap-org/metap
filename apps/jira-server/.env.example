NODE_ENV=development
HOST=0.0.0.0
# Different from crm-server's 3000 so both can run side by side on the same dev host.
PORT=3100
# RUST_LOG=info
# The PLATFORM's own control-plane database (control.tenants, and — see src/main.rs's doc
# comment for the caveat — auth/preferences/cron routes too, same as crm-server). NOT where
# jira.projects/jira.issues data lives — that's JIRA_TENANT_ID's own dedicated database below.
DATABASE_URL=postgres://metap:metap@localhost:5433/metap
RABBITMQ_URL=amqp://metap:metap@localhost:5672
CORS_ORIGINS=http://localhost:3100
AUTH_JWT_PUBLIC_KEY_PATH=./keys/dev-jwt-public.pem
AUTH_JWT_PRIVATE_KEY_PATH=./keys/dev-jwt-private.pem

# A real customer tenant (e.g. "my-jira"), NOT the platform's own dev/admin tenant — must
# already be provisioned before this process starts:
#   1. Create the tenant's own database: `createdb metap_myjira` (or any Postgres reachable
#      from this host — this codebase never creates the physical database itself).
#   2. Provision it: `cd apps/crm-server && ../../target/release/dev-tools provision-tenant \
#        <uuid> dedicated_db MY_JIRA_DSN postgres://metap:metap@localhost:5433/metap_myjira \
#        admin@my-jira.example <password>` — this migrates the dedicated DB and registers a
#      control.tenants row (run from any directory with dev-tools built; the tenant registry
#      itself always lives in DATABASE_URL above, not the new tenant's own DB).
#   3. Set both vars below: JIRA_TENANT_ID to the uuid from step 2, and the dsn_secret_ref var
#      named exactly as passed above (MY_JIRA_DSN) to the same DSN — Router's EnvStore looks it
#      up by this exact name at boot (for reconcile()) and per-request (for CrudService).
JIRA_TENANT_ID=
MY_JIRA_DSN=

# Opt-in distributed policy-row cache — see apps/crm-server/.env.example for the full
# explanation (same metap-infra::AppConfig field, same PermissionService::with_cache wiring).
# POLICY_CACHE_REDIS_URL=redis://127.0.0.1:6379
# POLICY_CACHE_TTL_SECONDS=30

# Runs outbox-publisher's drain loop inline in this same process, against this tenant's own
# dedicated database — required for jira.issues create/transition events to ever reach
# RabbitMQ at all, since the standalone `outbox-publisher` binary's normal deployment shape
# (`pnpm worker:outbox:rs`) points at crm-server's platform database, never this tenant's own
# (see src/main.rs's doc comment). Unset by default; set to `true` to enable.
# OUTBOX_WORKER_INLINE=true
# OUTBOX_POLL_MS=1000
# OUTBOX_BATCH_SIZE=100

# Opt-in — jira.issues file attachments (metap-storage::ObjectStore, its first real consumer
# anywhere in this repo). Unset by default (S3_BUCKET unset -> attachment routes 503). Dev
# backend: `docker compose up -d seaweedfs` (S3 API on localhost:8333, no auth required —
# S3_ACCESS_KEY/S3_SECRET_KEY can be any non-empty string against a dev SeaweedFS; a real S3 or
# S3-compatible server needs real credentials here).
# S3_ENDPOINT_URL=http://localhost:8333
# S3_BUCKET=jira-attachments
# S3_REGION=us-east-1
# S3_ACCESS_KEY=dev
# S3_SECRET_KEY=dev
