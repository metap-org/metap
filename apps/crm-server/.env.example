NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# tracing_subscriber::EnvFilter syntax, e.g. "info,metap_http=debug". Defaults to "info" if
# unset. Applies to every binary (crm-server, outbox-publisher, notification-worker, ...) via
# metap_infra::init_tracing().
# RUST_LOG=info
DATABASE_URL=postgres://metap:metap@localhost:5433/metap
RABBITMQ_URL=amqp://metap:metap@localhost:5672
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_JWT_PUBLIC_KEY_PATH=./keys/dev-jwt-public.pem
# Set to serve a built frontend (apps/crm-fe's `vite build` output) as static files
# alongside the API, single-process/single-port. Unset by default (split dev workflow —
# `pnpm dev:web` runs its own Vite dev server and proxies to this API instead).
# STATIC_DIR=../../apps/crm-fe/dist

# Set to run the notification worker (crates/notification-worker) as a background task
# inside this process instead of as its own deployable unit (`pnpm worker:notification:rs`).
# Unset by default — same reasoning as STATIC_DIR above, opt-in monolithic mode.
# NOTIFICATION_WORKER_INLINE=true
