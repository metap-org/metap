NODE_ENV=development
HOST=0.0.0.0
PORT=3000
# tracing_subscriber::EnvFilter syntax, e.g. "info,metap_http=debug". Defaults to "info" if
# unset. Applies to every binary (crm-server, outbox-publisher, notification-worker, ...) via
# metap_infra::init_tracing().
# RUST_LOG=info
DATABASE_URL=postgres://metap:metap@localhost:5433/metap
RABBITMQ_URL=amqp://metap:metap@localhost:5672
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
AUTH_JWT_PUBLIC_KEY_PATH=./keys/dev-jwt-public.pem
# Required since crm-server mints tokens too now (POST /auth/login), not just verifies them —
# same keypair `pnpm auth:dev-keys` already generates.
AUTH_JWT_PRIVATE_KEY_PATH=./keys/dev-jwt-private.pem
# Set to serve a built frontend (apps/crm-fe's `vite build` output) as static files
# alongside the API, single-process/single-port. Unset by default (split dev workflow —
# `pnpm dev:web` runs its own Vite dev server and proxies to this API instead).
# STATIC_DIR=../../apps/crm-fe/dist

# Set to run the notification worker (crates/notification-worker) as a background task
# inside this process instead of as its own deployable unit (`pnpm worker:notification:rs`).
# Unset by default — same reasoning as STATIC_DIR above, opt-in monolithic mode.
# NOTIFICATION_WORKER_INLINE=true

# Opt-in gRPC surface (crates/metap-grpc, generic CRUD-over-gRPC for crm.customers/etc.) — its
# own listener/port, since it needs HTTP/2-only serving unlike the REST/GraphQL port above. Off
# by default. This is what crates/graphql-gateway (the BFF aggregating crm-server + jira-server)
# connects to as its "crm" upstream.
# GRPC_ENABLED=true
# GRPC_PORT=3001

# crates/cron-scheduler config (pnpm worker:cron:rs) — only read by that binary, not crm-server.
# How often the ticker polls cron_jobs for due entries, and how many it claims per tick.
# CRON_TICK_MS=5000
# CRON_BATCH_SIZE=50
# Base URL of this crm-server instance — workflow_transition/bulk_query_action cron jobs call
# back into its own /api/:entity/... routes. Defaults to http://localhost:$PORT.
# CRON_TARGET_BASE_URL=http://localhost:3000
# A JWT (`pnpm mint-token`) for a service account with whatever role the jobs it runs need.
# Required for workflow_transition/bulk_query_action jobs; webhook-only jobs don't need it.
# CRON_SERVICE_JWT=

# Opt-in secret manager for resolving a DedicatedDb tenant's DSN (docs/roadmap.md Phase 8/16).
# metap_control::build_secret_store picks the backend: GCP_SECRETS_PROJECT_ID, then
# AWS_SECRETS_REGION, then VAULT_ADDR, else falls back to EnvStore (reads the DSN from a plain
# env var named by dsn_secret_ref). At most one of these three should be set.
# Two auth methods once VAULT_ADDR is set: AppRole (preferred — VAULT_ROLE_ID + VAULT_SECRET_ID,
# VAULT_APPROLE_MOUNT optional, defaults to "approle") takes precedence over a plain VAULT_TOKEN
# if both are set.
# VAULT_ADDR=http://localhost:8200
# VAULT_TOKEN=
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# VAULT_APPROLE_MOUNT=approle

# AWS Secrets Manager instead of Vault — explicit credentials, not the SDK's default provider
# chain (see AwsSecretsManagerStore's doc comment for why). AWS_SECRETS_ENDPOINT_URL is only for
# LocalStack or another AWS-API-compatible test double; unset for real AWS.
# AWS_SECRETS_REGION=us-east-1
# AWS_SECRETS_ACCESS_KEY=
# AWS_SECRETS_SECRET_KEY=
# AWS_SECRETS_ENDPOINT_URL=

# GCP Secret Manager instead of Vault/AWS — no access-key/secret-key pair here, identity comes
# from Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS pointing at a
# service-account JSON key file, or the ambient workload identity on GKE/Cloud Run/GCE).
# GCP_SECRETS_PROJECT_ID=

# Opt-in distributed policy-row cache (crates/metap-cache, docs/roadmap.md Phase 23) — unset
# means no caching at all (PermissionService::new, every load_snapshot queries policies fresh,
# exactly as before this cache existed). A plain redis:// URL — works unmodified against real
# Redis, DragonflyDB, or Valkey (`docker compose up -d dragonfly` for local dev).
# POLICY_CACHE_REDIS_URL=redis://127.0.0.1:6379
# POLICY_CACHE_TTL_SECONDS=30

# SMTP for metap-cron's TargetType::Email jobs (cron-scheduler's run_email, docs/roadmap.md
# Phase 39) — all optional; unset means an `email` job fails clearly at execution time, not at
# boot. Local dev points at Mailhog (`docker compose up -d mailhog`, no auth, web UI at
# http://localhost:8025) rather than a real provider account — leave SMTP_USER/SMTP_PASSWORD
# unset for Mailhog, set them for a real relay (which also requires implicit TLS/STARTTLS).
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=cron@metap.local
