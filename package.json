{
  "name": "metap-workspace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @metap/crm dev",
    "dev:web": "pnpm --filter @metap/demo dev",
    "build": "pnpm -r build",
    "start": "pnpm --filter @metap/crm start",
    "worker:outbox": "pnpm --filter @metap/crm worker:outbox",
    "index:reconcile": "pnpm --filter @metap/crm index:reconcile",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "lint:fix": "pnpm --filter @metap/core lint:fix",
    "format": "pnpm -r format",
    "format:check": "pnpm -r format:check",
    "db:generate": "pnpm --filter @metap/core db:generate",
    "db:migrate": "pnpm --filter @metap/core db:migrate",
    "db:migrate:test": "pnpm --filter @metap/core db:migrate:test",
    "db:studio": "pnpm --filter @metap/core db:studio",
    "auth:dev-keys": "pnpm --filter @metap/core auth:dev-keys",
    "mint-token": "pnpm --filter @metap/core mint-token",
    "seed:admin": "pnpm --filter @metap/core seed:admin"
  },
  "packageManager": "pnpm@9.15.0"
}
