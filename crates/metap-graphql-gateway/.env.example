NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# tracing_subscriber::EnvFilter syntax — see metap_infra::init_tracing(). Defaults to "info".
# RUST_LOG=info

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# This gateway's own keypair (decode-only — never mints tokens). Generate one the same way any
# other app in this repo does, e.g. `openssl genrsa -out keys/dev-jwt-private.pem 2048 &&
# openssl rsa -in keys/dev-jwt-private.pem -pubout -out keys/dev-jwt-public.pem`. A caller must
# present a token that decodes against this key to reach /graphql at all — if that caller's own
# token was signed by the SAME keypair as an upstream, it gets forwarded verbatim and enforces
# that real caller's own permissions there (`RequestContext::forwarded_bearer_token`); otherwise
# (or for the gateway's own boot-time calls, which have no caller to forward from) each upstream
# is called with the identity from that upstream's own UPSTREAM_<N>_SERVICE_EMAIL/PASSWORD below.
AUTH_JWT_PUBLIC_KEY_PATH=./keys/dev-jwt-public.pem

# Two mutually exclusive ways to configure upstreams — see src/config.rs's module doc comment.
# Every entity a given upstream's own GET /metadata/entities reports gets routed to that
# upstream's GRPC_ADDR for every actual read/write. The service-email/password credential is a
# real user this gateway logs into via that upstream's own POST /auth/login at boot (`dev-tools
# create-user`/`dev-tools seed-admin` to provision one) — it re-logs-in automatically in the
# background before the token expires (`metap_grpc::ServiceTokenSource`), so there's no
# hand-minted JWT to paste in or refresh by hand.
#
# Option A — one YAML file (recommended once you have more than 1-2 upstreams):
# UPSTREAM_CONFIG_FILE=./upstreams.yaml
#   upstreams:
#     - name: jira
#       grpcAddr: http://localhost:3101
#       metadataUrl: http://localhost:3100/metadata/entities
#       loginUrl: http://localhost:3100/auth/login
#       serviceEmail: gateway@jira.local
#       servicePassword: ""
#     - name: crm
#       grpcAddr: http://localhost:3001
#       metadataUrl: http://localhost:3000/metadata/entities
#       loginUrl: http://localhost:3000/auth/login
#       serviceEmail: gateway@crm.local
#       servicePassword: ""
#
# Option B — numbered env vars (default if UPSTREAM_CONFIG_FILE is unset), one block per
# upstream numbered from 1 — the loop in src/config.rs stops at the first missing "_NAME":
#
# UPSTREAM_1_NAME=jira
# UPSTREAM_1_GRPC_ADDR=http://localhost:3101
# UPSTREAM_1_METADATA_URL=http://localhost:3100/metadata/entities
# UPSTREAM_1_LOGIN_URL=http://localhost:3100/auth/login
# UPSTREAM_1_SERVICE_EMAIL=
# UPSTREAM_1_SERVICE_PASSWORD=
#
# UPSTREAM_2_NAME=crm
# UPSTREAM_2_GRPC_ADDR=http://localhost:3001
# UPSTREAM_2_METADATA_URL=http://localhost:3000/metadata/entities
# UPSTREAM_2_LOGIN_URL=http://localhost:3000/auth/login
# UPSTREAM_2_SERVICE_EMAIL=
# UPSTREAM_2_SERVICE_PASSWORD=
