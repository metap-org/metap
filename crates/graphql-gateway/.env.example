NODE_ENV=development
HOST=0.0.0.0
PORT=4000
# tracing_subscriber::EnvFilter syntax — see metap_infra::init_tracing(). Defaults to "info".
# RUST_LOG=info

CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# This gateway's own keypair (decode-only — never mints tokens). Generate one the same way any
# other app in this repo does, e.g. `openssl genrsa -out keys/dev-jwt-private.pem 2048 &&
# openssl rsa -in keys/dev-jwt-private.pem -pubout -out keys/dev-jwt-public.pem`. A caller must
# present a token that decodes against this key to reach /graphql at all — see README.md for why
# that identity is NOT what reaches either upstream (each upstream is called with its own fixed
# UPSTREAM_<N>_SERVICE_JWT below, regardless of who called the gateway).
AUTH_JWT_PUBLIC_KEY_PATH=./keys/dev-jwt-public.pem

# One block per upstream microservice, numbered from 1 — the loop in src/config.rs stops at the
# first missing "_NAME". Every entity a given upstream's own GET /metadata/entities reports gets
# routed to that upstream's GRPC_ADDR for every actual read/write.
#
# UPSTREAM_1_NAME=jira
# UPSTREAM_1_GRPC_ADDR=http://localhost:3101
# UPSTREAM_1_METADATA_URL=http://localhost:3100/metadata/entities
# A pre-minted token for jira-server's own keypair (`cd apps/jira-server && pnpm mint:jira-token`)
# — this is the fixed identity the gateway uses for every call to this one upstream (see
# metap_grpc::GrpcBackend's doc comment for why this isn't per-caller).
# UPSTREAM_1_SERVICE_JWT=
#
# UPSTREAM_2_NAME=crm
# UPSTREAM_2_GRPC_ADDR=http://localhost:3001
# UPSTREAM_2_METADATA_URL=http://localhost:3000/metadata/entities
# A pre-minted token for crm-server's own keypair (`cd apps/crm-server && pnpm mint-token`).
# UPSTREAM_2_SERVICE_JWT=
